# Dashboard
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
DEBUG_MODE=false
SESSION_COOKIE_SECURE=false
DASHBOARD_IDENTITY_MAX_AGE_SECONDS=43200
CLIENTS=CDA,EMIN,ENEX
MAPBOX_TOKEN=

# Campbell AI
# Everything except the real secrets below (an internal-token override, if you want
# one different from the image default) now lives as ENV defaults in the Dockerfile,
# since none of it is actually sensitive — see Dockerfile for the full list and
# docker-compose.yml's `environment:` block to override any of it without a rebuild.

# S3 access, shared with the data download and the auth log. Note that in this repo
# SECRET_KEY doubles as the AWS secret access key.
BUCKET_NAME=
ACCESS_KEY=
AWS_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=
