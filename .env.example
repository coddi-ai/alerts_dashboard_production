# Dashboard
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
DEBUG_MODE=false
SESSION_COOKIE_SECURE=false
DASHBOARD_IDENTITY_MAX_AGE_SECONDS=43200
CLIENTS=CDA,EMIN,ENEX
MAPBOX_TOKEN=

# Campbell AI
CAMPBELL_AI_ENABLED=true
CAMPBELL_AI_API_URL=http://127.0.0.1:8000
CAMPBELL_AI_API_TIMEOUT_SECONDS=90
CAMPBELL_AI_INTERNAL_TOKEN=replace-with-a-different-random-token
CAMPBELL_AI_DATA_ROOT=./data
CAMPBELL_AI_FEEDBACK_PATH=./logs/campbell_ai_feedback.jsonl
CAMPBELL_AI_SESSION_TTL_SECONDS=1800
CAMPBELL_AI_MAX_HISTORY_MESSAGES=20
CAMPBELL_AI_MAX_MESSAGE_CHARS=4000
# Agent turn budgets: the data analyst chains several detail tools for cross-source answers.
CAMPBELL_AI_MAX_TURNS_DATA_ANALYST=10
CAMPBELL_AI_MAX_TURNS_HEAD=10

# Conversation state. `memory` is process-local and only valid for a single worker;
# any deployment with more than one worker or replica must use `redis`.
CAMPBELL_AI_SESSION_BACKEND=memory
CAMPBELL_AI_REDIS_URL=
CAMPBELL_AI_REDIS_NAMESPACE=campbell:sessions
# Must outlive the slowest expected answer, since it is held across a whole agent run.
CAMPBELL_AI_SESSION_LOCK_TIMEOUT_SECONDS=300

# Progressive answers over SSE. Requires the same value in the Dash process.
CAMPBELL_AI_STREAMING=false
CAMPBELL_AI_STREAM_TIMEOUT_SECONDS=300

# S3 access, shared with the data download and the auth log. Note that in this repo
# SECRET_KEY doubles as the AWS secret access key.
BUCKET_NAME=
ACCESS_KEY=
AWS_REGION=us-east-1

# Durable backup of conversations and feedback. Uses the bucket above; Campbell AI only
# owns the folder below. With no bucket configured it still mirrors to disk.
CAMPBELL_AI_PERSISTENCE=true
CAMPBELL_AI_S3_PREFIX=campbellAI
CAMPBELL_AI_BACKUP_DIR=./logs/campbell_ai_backup
CAMPBELL_AI_HISTORY_LIMIT=50
# Titles archived conversations with a short AI summary once they have a few exchanges;
# the first user message is the fallback and always works.
CAMPBELL_AI_SUMMARY=true
CAMPBELL_AI_MODEL_SUMMARY=gpt-4.1-mini

# Admission control. One answer holds a worker for tens of seconds, so the useful global
# bound is low; the per-user bound keeps one person with several tabs from filling it.
CAMPBELL_AI_MAX_CONCURRENT_REQUESTS=10
CAMPBELL_AI_MAX_CONCURRENT_PER_USER=2
CAMPBELL_AI_MAX_REQUESTS_PER_MINUTE=200
# How long a queued request waits before answering 429 instead of holding a worker.
CAMPBELL_AI_QUEUE_TIMEOUT_SECONDS=20
# Retries apply only to transient upstream failures (429, 5xx, timeouts).
CAMPBELL_AI_RETRY_ATTEMPTS=3
CAMPBELL_AI_RETRY_INITIAL_DELAY=1
CAMPBELL_AI_RETRY_MAX_DELAY=30

# OpenAI
OPENAI_API_KEY=
CAMPBELL_AI_MODEL_GATEKEEPER=gpt-4.1-mini
CAMPBELL_AI_MODEL_HEAD=gpt-4.1-mini
CAMPBELL_AI_MODEL_PLANNER=gpt-4.1-mini
CAMPBELL_AI_MODEL_DATA_ANALYST=gpt-4.1
CAMPBELL_AI_MODEL_TECHNICAL_EXPERT=gpt-4.1-mini
CAMPBELL_AI_MODEL_DASHBOARD_GUIDE=gpt-4.1-mini
